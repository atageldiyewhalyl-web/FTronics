# ============================================================
# Legacy .html → clean URL redirects
# GENERATED FILE — do not edit by hand.
# Source: src/lib/redirects.mjs   Regenerate: npm run redirects:htaccess
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^agb\.html$ /agb [R=301,L]
  RewriteRule ^datenschutz\.html$ /datenschutz [R=301,L]
  RewriteRule ^faq\.html$ /faq [R=301,L]
  RewriteRule ^impressum\.html$ /impressum [R=301,L]
  RewriteRule ^karriere\.html$ /karriere [R=301,L]
